{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus[1m]",
  "permissions": {
    "allow": [
      "Bash(just check)",
      "Bash(just check-fast)",
      "Bash(just check-all)",
      "Bash(just test)",
      "Bash(just lint)",
      "Bash(just fmt)",
      "Bash(just fmt-check)",
      "Bash(just hygiene)",
      "Bash(just ios-fmt)",
      "Bash(just ios-fmt-check)",
      "Bash(just ios-test)",
      "Bash(just ios-snapshots-check)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(just testflight)",
      "Bash(just testflight:*)",
      "Bash(just ios-test-sim-clean)",
      "Bash(just ios-test-sim-clean:*)",
      "Bash(git push origin main)",
      "Bash(git push origin main:*)",
      "Bash(fly:*)",
      "Bash(flyctl:*)",
      "Bash(gh pr merge:*)",
      "Bash(xcrun simctl shutdown all)",
      "Bash(xcrun simctl erase:*)",
      "Bash(simctl erase:*)",
      "Bash(killall CoreSimulatorService)",
      "Bash(killall -9 CoreSimulatorService)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/install-git-hooks.sh >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *ios/generated/*) ;; *.rs) command -v rustfmt >/dev/null 2>&1 && rustfmt --edition 2021 \"$f\" >/dev/null 2>&1 ;; *.swift) swift format --in-place \"$f\" >/dev/null 2>&1 ;; esac; exit 0"
          }
        ]
      }
    ]
  }
}
