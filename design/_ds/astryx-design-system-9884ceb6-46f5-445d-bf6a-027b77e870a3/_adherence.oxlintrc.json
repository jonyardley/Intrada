      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:info|success|warning|error)$/]",
        "message": "<Toast> type must be one of 'info' | 'success' | 'warning' | 'error'."
      }
    ]
  },
