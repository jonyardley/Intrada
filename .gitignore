.swiftpm/
DerivedData/
*.xcresult
*.ipa
*.dSYM.zip
*.dSYM
design/images/generated-*.png
# Ad-hoc macOS screenshots dropped into design/ — scratch, not design sources
design/Screenshot*.png
# Native iOS — generated Swift packages (UniFFI bindings + facet typegen).
# A build precondition, regenerated by `just native-gen` — never committed.
ios/generated/
crates/intrada-ffi/generated/
crates/intrada-ffi/IntradaCoreFFI/
# xcodegen-generated project + xcodebuild output (regenerated from project.yml)
ios/*.xcodeproj/
ios/build/
# fastlane TestFlight lane output (build dir holds the .ipa/.xcarchive) + scratch.
# Gemfile.lock is intentionally NOT ignored — commit it for reproducible CI.
/build/
*.xcarchive
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
# Local coverage report written by `just coverage`; CI uploads its own copy.
codecov.json
# xcode-build-server config for sourcekit-lsp, in Zed and in the agent's lsp
# tool: machine-local absolute paths, regenerated per checkout by
# `just lsp-setup` (see .zed/settings.json, docs/working-with-agents.md)
buildServer.json
# Per-file compiler flags written by `xcode-build-server parse` in
# `just lsp-setup`: 100KB+ of absolute machine paths, same reasoning as above.
.compile
# graphify knowledge-graph output: machine-local, never committed (a re-recorded
# multi-MB graph.json compounds in history like snapshot PNGs). The canonical
# graph lives in the main checkout; scope is controlled by the committed
# .graphifyignore. See CLAUDE.md "Knowledge graph (graphify)".
graphify-out/
# Per-developer mise overlay (e.g. RUSTC_WRAPPER=sccache) — see SETUP.md §5.
# Never committed: mise.toml itself must stay identical for everyone.
mise.local.toml
docs/status.md
# Playwright MCP server scratch (traces, screenshots dropped at the repo root)
.playwright-mcp/
